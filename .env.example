# URL pública do site (usada em sitemap.xml e robots.txt)
BASE_URL=http://localhost:8000

# Google Analytics 4 - Measurement ID (ex.: G-XXXXXXXXXX). Vazio desativa o GA.
GA_ID=

# Porta do servidor
PORT=8000

# OCR de PDFs digitalizados (idioma, idioma de fallback, resolução e ativação)
# OCR_LANGUAGE: idioma principal; OCR_LANGUAGE_FALLBACK: usado se o principal falhar
OCR_LANGUAGE=por
OCR_LANGUAGE_FALLBACK=eng
OCR_DPI=200
# Desligue o OCR para converter mais rápido (perde o texto de páginas digitalizadas)
OCR_ENABLED=true

# Timeout da conversão em segundos (livros digitalizados demoram mais)
CONVERSION_TIMEOUT_SECONDS=600
