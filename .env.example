# URL pública do site (usada em sitemap.xml e robots.txt)
BASE_URL=http://localhost:8000

# Google Analytics 4 - Measurement ID (ex.: G-XXXXXXXXXX). Vazio desativa o GA.
GA_ID=

# Porta do servidor
PORT=8000

# OCR de PDFs digitalizados (idioma, idioma de fallback, resolução e ativação)
# OCR_LANGUAGE: idioma principal; OCR_LANGUAGE_FALLBACK: usado se o principal falhar
OCR_LANGUAGE=por
OCR_LANGUAGE_FALLBACK=eng
OCR_DPI=200
# Desligue o OCR para converter mais rápido (perde o texto de páginas digitalizadas)
OCR_ENABLED=true

# Timeout da conversão em segundos (livros digitalizados demoram mais)
CONVERSION_TIMEOUT_SECONDS=600

# Google AdSense - preencha após aprovação do Google
# ADSENSE_ENABLED=true liga os anúncios; exige consentimento de cookies.
ADSENSE_ENABLED=false
ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT=0000000000

# Escalabilidade - limites de conversões ativas
# MAX_CONCURRENT_JOBS: total global de conversões em paralelo.
# MAX_JOBS_PER_IP: máximo por IP. Exceder retorna HTTP 429.
MAX_CONCURRENT_JOBS=3
MAX_JOBS_PER_IP=2

# Caminho do LibreOffice para conversão de formatos legados
# (.doc, .xls, .ppt, .odt, .ods, .odp) - requer instalação do LibreOffice
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
